# Ejemplo de configuración del Support Assistant. Cópialo como .env en esta carpeta
# (product/) y llena tus valores: el producto lo lee al arrancar. Las variables del
# entorno ganan sobre las del archivo. Nunca subas .env al repositorio.

# Archivo de configuración que se lee al arrancar (none: ninguno). Esta variable solo
# tiene efecto en el entorno, no dentro del archivo.
# ENV_FILE=.env

# Entorno (development o production). Con production el producto no arranca si
# falla una regla de compliance (ver doc/compliance-checklist.md).
ENVIRONMENT=development

# Claves por cliente con la forma cliente:clave,cliente2:clave2. Son secretas:
# déjala vacía aquí y llénala solo en tu .env (vacía: nadie entra a /ask ni /metrics).
API_KEYS=
# Peticiones por cliente por minuto (1 o más)
RATE_LIMIT_PER_MINUTE=30

# Modo demo: con true, POST /ask acepta preguntas sin clave como el cliente public,
# con un límite por IP y un tope de gasto diario. GET /metrics sigue pidiendo clave.
PUBLIC_PAGE=false
# Preguntas sin clave por dirección IP por minuto (mayor que 0 con PUBLIC_PAGE=true)
PUBLIC_RATE_LIMIT_PER_MINUTE=5
# Tope de gasto diario (USD, día UTC) de las preguntas sin clave (mayor que 0 con
# PUBLIC_PAGE=true). Vive en memoria: vuelve a cero al reiniciar el servicio.
DAILY_BUDGET_USD=0.50
# Leer la IP de la última entrada de X-Forwarded-For. Solo detrás de un proxy de
# confianza (como Render); en tu equipo déjalo en false.
TRUST_PROXY=false

# Modelo y agente (fake: simulado y sin red; gateway: Workers AI vía AI Gateway)
MODEL_PROVIDER=fake
AGENT_MAX_STEPS=4
MAX_QUESTION_CHARS=2000

# Cloudflare (solo con MODEL_PROVIDER=gateway). La cuenta y el token son secretos:
# déjalos vacíos aquí y llénalos solo en tu .env.
CF_ACCOUNT_ID=
CF_GATEWAY_ID=default
CF_API_TOKEN=

# Modelos y palancas de costo
MODEL_SMALL=@cf/meta/llama-3.1-8b-instruct-fast
MODEL_LARGE=@cf/meta/llama-3.3-70b-instruct-fp8-fast
ROUTING=true
ROUTER_MAX_CHARS=80
HISTORY_WINDOW=6
MODEL_MAX_TOKENS=300
MODEL_TEMPERATURE=0
CACHE_TTL_SECONDS=0
PRICES_PATH=data/model_prices.json

# Base de conocimiento
KB_PATH=data/knowledge_base.json
KB_MIN_SCORE=2
KB_MAX_RESULTS=2

# Observabilidad
SERVICE_NAME=support-assistant
# Meta de latencia p95 en milisegundos (con el modelo real, dos llamadas por pregunta)
SLO_P95_MS=4000
# true registra la pregunta y la respuesta en el evento agent_run (datos personales)
LOG_CONVERSATION_TEXT=true

# Trazas en LangSmith (opcionales): se encienden solo con LANGSMITH_TRACING=true y
# una clave. La clave es secreta: déjala vacía aquí y ponla solo en tu .env.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# Proyecto de LangSmith donde caen las trazas (nunca default)
LANGSMITH_PROJECT=support-assistant
# Solo para cuentas de la región europea de LangSmith:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# true: no se manda ninguna entrada. Usa false solo en desarrollo.
HIDE_INPUTS=true
# true: de las salidas solo se manda usage_metadata (los tokens), nunca el texto.
HIDE_OUTPUTS=true
